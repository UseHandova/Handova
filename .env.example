# ── Frontend (Vite — exposed to the browser, never put private keys here) ──
# Circle Modular Wallets client key + URL (console.circle.com → Modular Wallets)
VITE_CLIENT_KEY=
VITE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
# Deployed contracts on Arc Testnet
VITE_ESCROW_ADDRESS=0x29993a0e1BF9ef863c10Bfc7171c410DCE9Fe7Ca
VITE_NFT_ADDRESS=0x78A84547a4372950b4898DE06c008D83F18D445F
# Optional: extra admin wallet for older escrow deployments without an onchain arbiter
VITE_ADMIN_ADDRESS=
# WhatsApp bot number + first-time join message (Twilio sandbox) for the "List on WhatsApp" button
VITE_WHATSAPP_BOT_NUMBER=+17372508034
VITE_WHATSAPP_JOIN_CODE=join twilio-trial

# ── WhatsApp bot server (server/whatsapp-bot.ts) ──
BOT_SECRET=
# Optional public app URL — bot replies include a tap-to-publish link (https://your-app/?wa=123456)
APP_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+17372508034
# AI for parsing listings + voice notes. Groq is free (console.groq.com); OpenAI is used only if GROQ_API_KEY is empty.
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Landlord verification (server) ──
# Didit (free: 500/month — ID document + liveness + face match). business.didit.me →
#   API & Webhooks → API Key, and Workflows → create from the "KYC" template (remove the paid AML step) → Workflow ID
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# Optional: force a provider (didit | dojah). Default: Didit when configured, else Dojah.
KYC_PROVIDER=
# Where Didit may send users back to after verification (comma-separated). Default: APP_URL + http://localhost:5175
APP_ORIGINS=
# Dojah KYC (real NIMC database lookup, paid in production) — dojah.io → Developers → Configuration. Sandbox test NIN: 70123456789
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_ENV=sandbox
# Backend key with the escrow's verifier role (records verified badges onchain; needs a little gas)
VERIFIER_PRIVATE_KEY=
# Optional: secret for hashing NINs (one NIN per account). Defaults to a value derived from VERIFIER_PRIVATE_KEY
NIN_PEPPER=
