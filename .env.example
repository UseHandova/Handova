# ── Frontend (Vite — exposed to the browser, never put private keys here) ──
# Circle Modular Wallets client key + URL (console.circle.com → Modular Wallets)
VITE_CLIENT_KEY=
VITE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
# Deployed contracts on Arc Testnet
VITE_ESCROW_ADDRESS=0x29993a0e1BF9ef863c10Bfc7171c410DCE9Fe7Ca
VITE_NFT_ADDRESS=0x78A84547a4372950b4898DE06c008D83F18D445F
# Rent savings vault (no owner — only savers can move their money)
VITE_SAVINGS_VAULT_ADDRESS=0x319c6Da874F81379E2ADa1FE3c539816813B8dCA
# WhatsApp bot number + first-time join message (Twilio sandbox) for the "List on WhatsApp" button
VITE_WHATSAPP_BOT_NUMBER=+14155238886
VITE_WHATSAPP_JOIN_CODE=join <your-sandbox-code>

# ── WhatsApp bot server (server/whatsapp-bot.ts) ──
BOT_SECRET=
# Webhook security: Twilio signs every webhook; the bot rejects unsigned/forged ones.
# Set this if your public URL differs from what the proxy forwards (e.g. https://bot.example.com/api/whatsapp/incoming).
PUBLIC_WEBHOOK_URL=
# Only for local curl testing — never in production.
TWILIO_VALIDATE_SIGNATURE=true
# SQLite database for drafts, reviews, maintenance, boosts, referrals, moderation
RENTFLOW_DB=server/data/rentflow.db
# Signs 7-day sign-in sessions (defaults to a value derived from VERIFIER_PRIVATE_KEY)
SESSION_SECRET=
# Receives listing-boost payments (USDC); the server verifies each payment onchain
TREASURY_ADDRESS=
# Public app URL. WhatsApp messages link back to it (listing drafts, inspection updates, chat replies).
APP_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# While on the Twilio sandbox: the join phrase people must send once (shown on the phone sign-in screen).
# Leave empty on a real WhatsApp number.
TWILIO_SANDBOX_JOIN=join gun-heart
# AI for parsing listings + voice notes. Groq is free (console.groq.com); OpenAI is used only if GROQ_API_KEY is empty.
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Landlord verification (server) ──
# Didit (free: 500/month — ID document + liveness + face match). business.didit.me →
#   API & Webhooks → API Key, and Workflows → create from the "KYC" template (remove the paid AML step) → Workflow ID
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# Optional: force a provider (didit | dojah). Default: Didit when configured, else Dojah.
KYC_PROVIDER=
# Where Didit may send users back to after verification (comma-separated). Default: APP_URL + http://localhost:5175
APP_ORIGINS=
# Dojah KYC (real NIMC database lookup, paid in production) — dojah.io → Developers → Configuration. Sandbox test NIN: 70123456789
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_ENV=sandbox
# Backend key with the escrow's verifier role (records verified badges onchain; needs a little gas)
VERIFIER_PRIVATE_KEY=
# Optional: secret for hashing NINs (one NIN per account). Defaults to a value derived from VERIFIER_PRIVATE_KEY
NIN_PEPPER=

# ── Media storage (optional; default is local disk at MEDIA_DIR) ──
# S3-compatible bucket, e.g. Cloudflare R2. All four required to enable.
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=

# Encrypts property-ownership documents while they wait for review (64 hex chars: `openssl rand -hex 32`).
# Keep it with your backups — without it, documents still pending can't be opened. Reviewed documents are deleted anyway.
OWNERSHIP_KEY=

# Shown on the /privacy page as the way to contact you about privacy requests (an email address or a URL).
VITE_PRIVACY_CONTACT=

# Daily encrypted backups (server/backup.ts). Uses BACKUP_KEY, or OWNERSHIP_KEY if this is empty.
BACKUP_KEY=
# Optional off-site copy (any S3-compatible bucket, e.g. Cloudflare R2). Without it, backups stay on the server's disk.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# SMS login codes for numbers not on WhatsApp (Termii — https://termii.com). Without a key, codes are printed in the
# server log in development, and SMS is unavailable in production. Use the "dnd" channel for codes (ask Termii support
# to enable it); sending codes on "generic" can get your sender ID blocked.
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd
